---
import { getCollection, render } from 'astro:content';
import { hasToc } from '../../lib/toc';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import Cta from '../../components/Cta.astro';
import JsonLd from '../../components/JsonLd.astro';
import Toc from '../../components/Toc.astro';

export async function getStaticPaths() {
  const entries = await getCollection('providers', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, all: entries },
  }));
}

const { entry, all } = Astro.props;
const { Content, headings } = await render(entry);
const path = `/dmarc-for/${entry.id}/`;
const image = `/open-graph/dmarc-for/${entry.id}.png`;
const showToc = hasToc(headings, { maxDepth: 3 });

// Link to the other provider guides for internal linking, alphabetically as on the
// index. Sorting is what makes the build reproducible: unsorted, this slice took
// whatever order the filesystem gave getCollection.
const related = all
  .filter((e) => e.id !== entry.id)
  .sort((a, b) => a.data.provider.localeCompare(b.data.provider))
  .slice(0, 3)
  .map((e) => ({ label: e.data.title, href: `/dmarc-for/${e.id}/` }));

const published = entry.data.publishDate.toISOString();
const modified = (entry.data.updatedDate ?? entry.data.publishDate).toISOString();
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.description,
  image: new URL(image, Astro.site).href,
  datePublished: published,
  dateModified: modified,
  author: { '@type': 'Organization', name: 'DMARC Analyzer' },
  publisher: { '@type': 'Organization', name: 'DMARC Analyzer' },
  mainEntityOfPage: new URL(path, Astro.site).href,
};
---
<BaseLayout current="setup" title={`${entry.data.seoTitle ?? entry.data.title} — DMARC Analyzer`} description={entry.data.description} path={path} image={image} ogType="article" publishedTime={published} modifiedTime={modified}>
  <JsonLd slot="head" schema={articleSchema} />
    <article style={`max-width:${showToc ? 1044 : 760}px; margin:0 auto; padding:40px 32px 72px;`}>
      <Breadcrumbs items={[
        { label: 'Home', href: '/' },
        { label: 'DMARC setup', href: '/dmarc-for/' },
        { label: entry.data.provider, href: path },
      ]} />
      <h1 style="font-family:'Space Grotesk',sans-serif; font-size:40px; line-height:1.1; letter-spacing:-0.03em; font-weight:600; margin:22px 0 10px;">{entry.data.title}</h1>
      <p style="font-size:var(--text-lg); line-height:1.5; color:var(--text-faint); margin:0 0 32px;">{entry.data.description}</p>

      <div class="article-body" style={showToc ? 'display:grid; grid-template-columns:minmax(0,760px) 240px;' : undefined}>
        <div class="article-content">
          <div class="prose">
            <Content />
          </div>
        </div>

        {showToc && <Toc headings={headings} maxDepth={3} />}
      </div>

      <RelatedLinks title="Other providers" links={related} />
      <Cta title="Monitor every client domain in one place" text="DMARC Analyzer is open source and self-hosted — ingest reports from all your providers and domains in one dashboard, on your own infrastructure. No per-domain fees." />
    </article>
</BaseLayout>
