---
import Icon from './Icon.astro';

const GH = 'https://github.com/dmarc-analyzer-net/DmarcAnalyzerApp';
---
<footer style="border-top:1px solid var(--border-default);">
  <div style="max-width:1160px; margin:0 auto; padding:40px 32px; display:flex; align-items:center; justify-content:space-between; gap:24px; flex-wrap:wrap;">
    <div style="display:flex; align-items:center; gap:10px;">
      <span style="width:26px; height:26px; border-radius:var(--radius-xs); background:linear-gradient(135deg,#0d9488,#115e59); display:flex; align-items:center; justify-content:center;"><Icon name="shield-energy" style="font-size:15px; color:var(--teal-50);" /></span>
      <span style="font-family:'Space Grotesk',sans-serif; font-size:14px; font-weight:600;">DMARC Analyzer</span>
      <span style="font-size:13px; color:var(--text-faint); margin-left:6px;">Open-source DMARC monitoring for agencies.</span>
    </div>
    <div style="display:flex; align-items:center; gap:24px; font-size:13px;">
      <a class="navlink" href="/" style="font-weight:500;">Home</a>
      <a class="navlink" href="/features" style="font-weight:500;">Features</a>
      <a class="navlink" href="/docs" style="font-weight:500;">Docs</a>
      <a class="navlink" href={GH} style="font-weight:500;">GitHub</a>
      <span style="color:var(--text-faint);">Apache-2.0</span>
    </div>
  </div>
</footer>
