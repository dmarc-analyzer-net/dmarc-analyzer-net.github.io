---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const terms = (await getCollection('glossary', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.term.localeCompare(b.data.term),
);
---
<BaseLayout
  title="DMARC glossary — DMARC Analyzer"
  description="Plain-language definitions of DMARC, SPF, DKIM, alignment, aggregate reports, and the policy tags you meet while securing email."
  path="/glossary"
>
  <div style="min-height:100vh;">
    <Header current="glossary" />
    <section style="background:radial-gradient(800px 360px at 20% -20%, rgba(20,184,166,0.13), transparent 65%);">
      <div style="max-width:960px; margin:0 auto; padding:72px 32px 32px;">
        <div style="font-size:13px; font-weight:600; color:#0c7568; margin-bottom:14px;">Glossary</div>
        <h1 style="font-family:'Space Grotesk',sans-serif; font-size:44px; line-height:1.06; letter-spacing:-0.03em; font-weight:600; margin:0 0 18px;">Email authentication, in plain language.</h1>
        <p style="font-size:18px; line-height:1.5; color:#425551; margin:0; max-width:600px;">Short, precise definitions of the terms you meet while setting up and monitoring DMARC.</p>
      </div>
    </section>
    <section style="max-width:960px; margin:0 auto; padding:32px 32px 72px;">
      <dl style="margin:0; display:grid; grid-template-columns:repeat(auto-fill,minmax(280px,1fr)); gap:14px;">
        {terms.map((t) => (
          <a class="lift" href={`/glossary/${t.id}`} style="display:block; border:1px solid #c8ded7; border-radius:12px; background:#ffffff; padding:18px 20px; color:#0c1a18 !important;">
            <dt style="font-size:16px; font-weight:600; letter-spacing:-0.01em; margin:0 0 6px;">{t.data.term}</dt>
            <dd style="font-size:13.5px; line-height:1.55; color:#425551; margin:0;">{t.data.description}</dd>
          </a>
        ))}
      </dl>
    </section>
    <Footer />
  </div>
</BaseLayout>
