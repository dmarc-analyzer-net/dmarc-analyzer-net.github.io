---
/**
 * The brand mark — gradient square with the shield glyph.
 *
 * This is deliberately not an `Icon`. The design system rules that the logo is
 * not part of the icon set: sourcing it from there strips the gradient and
 * makes the glyph inherit `currentColor`. Geometry is the DS's
 * `assets/logo-mark.svg`, scaled to the requested size.
 *
 * The gradient stops are stock Tailwind teal-600/800 rather than brand teal.
 * That is the artwork of record — the DS adjudicated it as final and says not
 * to snap it to the palette.
 *
 * The glyph stroke is a literal #f0fdfa (stock Tailwind teal-50) for the same
 * reason, and deliberately not `var(--teal-50)`, which is the palette's #effaf7.
 * The whole mark is drawn in stock Tailwind teal — 50 for the glyph, 600 to 800
 * for the gradient — so pointing one of the three at the palette half-converts
 * artwork the DS says to leave alone, and makes the rendered mark differ from
 * the files published at /brand/. The difference is invisible; the drift is the
 * problem.
 */
interface Props {
  /** Rendered edge length in px. The DS draws the corner at ~0.2 of the box. */
  size?: number;
  class?: string;
}
const { size = 30, class: className } = Astro.props;
// Each instance needs its own gradient id, or the first one on the page wins.
const gid = `dmg-${Math.random().toString(36).slice(2, 9)}`;
---
<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 70 70"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
  style="display:block; flex-shrink:0;"
>
  <defs>
    <linearGradient id={gid} x1="0" y1="0" x2="70" y2="70" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#0d9488" />
      <stop offset="1" stop-color="#115e59" />
    </linearGradient>
  </defs>
  <rect width="70" height="70" rx="16" fill={`url(#${gid})`} />
  <g
    transform="translate(14 14) scale(1.75)"
    fill="none"
    stroke="#f0fdfa"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" />
    <path d="M13 8.5 10.5 12.5h3L11 16.5" />
  </g>
</svg>
