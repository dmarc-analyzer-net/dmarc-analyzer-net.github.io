---
import { getCollection, render } from 'astro:content';
import { DOCS_SECTIONS } from '../../lib/docs';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import DocsSidebar from '../../components/DocsSidebar.astro';
import JsonLd from '../../components/JsonLd.astro';
import Toc from '../../components/Toc.astro';

export async function getStaticPaths() {
  const entries = await getCollection('docs', ({ data }) => !data.draft);
  const ordered = [...entries].sort((a, b) =>
    a.data.section === b.data.section
      ? a.data.order - b.data.order
      : a.data.section.localeCompare(b.data.section),
  );
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, ordered },
  }));
}

const { entry, ordered } = Astro.props;
const { Content, headings } = await render(entry);
const path = `/docs/${entry.id}/`;

// Prev/next within the reading sequence (section, then order).

const sequence = [...ordered].sort((a, b) => {
  const s = DOCS_SECTIONS.indexOf(a.data.section) - DOCS_SECTIONS.indexOf(b.data.section);
  return s !== 0 ? s : a.data.order - b.data.order;
});
const index = sequence.findIndex((e) => e.id === entry.id);
const prev = index > 0 ? sequence[index - 1] : null;
const next = index >= 0 && index < sequence.length - 1 ? sequence[index + 1] : null;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: entry.data.title,
  description: entry.data.description,
  author: { '@type': 'Organization', name: 'DMARC Analyzer' },
  publisher: { '@type': 'Organization', name: 'DMARC Analyzer' },
  mainEntityOfPage: new URL(path, Astro.site).href,
};
---
<BaseLayout current="docs" title={`${entry.data.seoTitle ?? entry.data.title} — DMARC Analyzer docs`} description={entry.data.description} path={path}>
  <JsonLd slot="head" schema={schema} />
    <div class="docs-shell" style="max-width:1160px; margin:0 auto; padding:32px 32px 72px; display:grid; grid-template-columns:230px minmax(0,1fr); gap:44px; align-items:start;">
      <aside class="docs-aside" style="position:sticky; top:88px;">
        <h2 class="docs-aside-heading">All documentation</h2>
        <DocsSidebar current={entry.id} />
      </aside>

      <article style="min-width:0;">
        <Breadcrumbs items={[
          { label: 'Home', href: '/' },
          { label: 'Docs', href: '/docs/' },
          { label: entry.data.title, href: path },
        ]} />
        <h1 style="font-family:'Space Grotesk',sans-serif; font-size:var(--text-3xl); line-height:1.12; letter-spacing:-0.03em; font-weight:600; margin:18px 0 10px;">{entry.data.title}</h1>
        <p style="font-size:var(--text-lead); line-height:1.5; color:var(--text-faint); margin:0 0 28px;">{entry.data.description}</p>

        <Toc headings={headings} />

        <div class="prose">
          <Content />
        </div>

        {(prev || next) && (
          <nav aria-label="Pagination" style="margin-top:48px; border-top:1px solid var(--border-default); padding-top:20px; display:flex; gap:16px; justify-content:space-between; flex-wrap:wrap;">
            {prev ? (
              <a class="lift" href={`/docs/${prev.id}/`} style="flex:1 1 220px; border:1px solid var(--border-strong); border-radius:var(--radius-lg); background:#fff; padding:14px 16px; color:var(--text-body) !important;">
                <span style="display:block; font-size:var(--text-xs); color:var(--text-faint);">Previous</span>
                <span style="display:block; margin-top:2px; font-size:14.5px; font-weight:600;">{prev.data.title}</span>
              </a>
            ) : <span style="flex:1 1 220px;"></span>}
            {next ? (
              <a class="lift" href={`/docs/${next.id}/`} style="flex:1 1 220px; border:1px solid var(--border-strong); border-radius:var(--radius-lg); background:#fff; padding:14px 16px; text-align:right; color:var(--text-body) !important;">
                <span style="display:block; font-size:var(--text-xs); color:var(--text-faint);">Next</span>
                <span style="display:block; margin-top:2px; font-size:14.5px; font-weight:600;">{next.data.title}</span>
              </a>
            ) : <span style="flex:1 1 220px;"></span>}
          </nav>
        )}
      </article>
    </div>
</BaseLayout>
