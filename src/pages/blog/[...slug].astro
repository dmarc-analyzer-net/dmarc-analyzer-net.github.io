---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Byline from '../../components/Byline.astro';
import JsonLd from '../../components/JsonLd.astro';
import Toc from '../../components/Toc.astro';
import { hasToc } from '../../lib/toc';
import { AUTHOR, byNewest } from '../../lib/blog';

export async function getStaticPaths() {
  const entries = await getCollection('blog', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const path = `/blog/${entry.id}/`;
const image = `/open-graph/blog/${entry.id}.png`;
const showToc = hasToc(headings, { maxDepth: 3 });

const published = entry.data.publishDate.toISOString();
const modified = (entry.data.updatedDate ?? entry.data.publishDate).toISOString();

// BlogPosting rather than Article, and with a real author. Guides are
// deliberately unattributed reference material; a post is research and opinion,
// and the named identity is the point.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: published,
  dateModified: modified,
  image: new URL(image, Astro.site).href,
  mainEntityOfPage: { '@type': 'WebPage', '@id': new URL(path, Astro.site).href },
  author: { '@type': 'Person', name: entry.data.author, sameAs: AUTHOR.sameAs },
  publisher: { '@type': 'Organization', name: 'DMARC Analyzer', url: Astro.site?.href },
};
---
<BaseLayout
  title={`${entry.data.title} — DMARC Analyzer`}
  description={entry.data.description}
  path={path}
  image={image}
  ogType="article"
  publishedTime={published}
  modifiedTime={modified}
>
  <JsonLd slot="head" schema={schema} />
  <section style="max-width:760px; margin:0 auto; padding:56px 32px 8px;">
    <Breadcrumbs items={[
      { label: 'Home', href: '/' },
      { label: 'Blog', href: '/blog/' },
      { label: entry.data.title, href: path },
    ]} />
    <h1 style="font-family:'Space Grotesk',sans-serif; font-size:var(--text-4xl); line-height:1.1; letter-spacing:-0.03em; font-weight:600; margin:22px 0 18px;">{entry.data.title}</h1>
    <Byline
      author={entry.data.author}
      publishDate={entry.data.publishDate}
      updatedDate={entry.data.updatedDate}
      type={entry.data.type}
    />

    {entry.data.method && (
      <aside style="border-left:3px solid var(--brand); padding:14px 18px; margin:0 0 28px; background:rgba(20,184,166,0.05); font-size:var(--text-sm); line-height:1.6;">
        <strong style="display:block; margin-bottom:6px;">Method</strong>
        <span style="color:var(--gray-700);">{entry.data.method}</span>
      </aside>
    )}

    {showToc && <Toc headings={headings} />}
    <div class="prose"><Content /></div>

    {entry.data.corrections.length > 0 && (
      <aside style="border-top:1px solid var(--border-default); margin:40px 0 0; padding:20px 0 0;">
        <strong style="display:block; font-size:var(--text-sm); margin-bottom:10px;">Corrections</strong>
        <ul style="font-size:var(--text-sm); color:var(--gray-700); margin:0; padding-left:18px;">
          {entry.data.corrections.map((c) => (
            <li style="margin-bottom:6px;">
              <time datetime={c.date.toISOString()}>{c.date.toISOString().slice(0, 10)}</time> — {c.note}
            </li>
          ))}
        </ul>
      </aside>
    )}

    {entry.data.attribution && (
      <p style="font-size:var(--text-sm); color:var(--text-faint); margin:28px 0 0;">{entry.data.attribution}</p>
    )}
  </section>
</BaseLayout>
