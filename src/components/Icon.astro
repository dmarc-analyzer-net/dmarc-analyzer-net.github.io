interface Props {
  name: string;
  class?: string;
  style?: string;
  /** Accessible label. If omitted the icon is decorative (aria-hidden). */
  title?: string;
}

const { name, class: className, style, title } = Astro.props;
const d = ICON_PATHS[name];
if (!d) {
  console.warn(`[Icon] unknown icon name: "${name}"`);
}
