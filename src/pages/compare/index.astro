---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Cta from '../../components/Cta.astro';

const entries = (await getCollection('compare', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.competitor.localeCompare(b.data.competitor),
);

export const title = 'Compare DMARC Analyzer to the alternatives';
export const description =
  'How an open-source, self-hosted DMARC analyzer compares to dmarcian, EasyDMARC, PowerDMARC, Valimail, and parsedmarc — on hosting, pricing, and data ownership.';
---
<BaseLayout current="compare"
  title={title}
  description={description}
  path="/compare/"
  image="/open-graph/compare.png"
>
    <section style="background:radial-gradient(800px 360px at 20% -20%, rgba(20,184,166,0.13), transparent 65%);">
      <div style="max-width:960px; margin:0 auto; padding:72px 32px 32px;">
        <div style="font-size:var(--text-sm); font-weight:600; color:var(--brand); margin-bottom:14px;">Compare</div>
        <h1 style="font-family:'Space Grotesk',sans-serif; font-size:44px; line-height:1.06; letter-spacing:-0.03em; font-weight:600; margin:0 0 18px; max-width:740px;">Honest comparisons — hosting, pricing, and who owns your data.</h1>
        <p style="font-size:var(--text-lg); line-height:1.5; color:var(--gray-700); margin:0; max-width:640px;">Most commercial DMARC platforms are vendor-hosted and priced per domain. Here's how a self-hosted, open-source analyzer stacks up against each — and where each alternative genuinely fits.</p>
      </div>
    </section>
    <section style="max-width:960px; margin:0 auto; padding:32px 32px 72px;">
      <ul style="list-style:none; margin:0; padding:0; display:grid; grid-template-columns:repeat(auto-fill,minmax(280px,1fr)); gap:16px;">
        {entries.map((e) => (
          <li>
            <a class="lift" href={`/compare/${e.id}/`} style="display:block; height:100%; border:1px solid var(--border-strong); border-radius:var(--radius-lg); background:var(--surface-card); padding:22px 24px; color:var(--text-body) !important;">
              <h2 style="font-size:var(--text-lg); font-weight:600; letter-spacing:-0.01em; margin:0 0 8px; display:flex; align-items:center; justify-content:space-between; gap:12px;">
                {e.data.roundup ? e.data.competitor : `vs ${e.data.competitor}`}
                <Icon name="arrow-right" style="font-size:17px; color:var(--brand);" />
              </h2>
              <p style="font-size:var(--text-base); line-height:1.55; color:var(--gray-700); margin:0;">{e.data.description}</p>
            </a>
          </li>
        ))}
      </ul>

      <!-- The one pattern that holds across every entry above, not repeated in
           each page's own table. -->
      <div class="prose" style="margin-top:44px; max-width:720px;">
        <h2>The pattern across every alternative</h2>
        <p>
          Every commercial platform above is vendor-hosted and priced by
          <strong>domain count and message volume</strong> — the more domains you
          watch and the more mail they send, the more the bill grows. DMARC
          Analyzer is the one constant on the other side of every comparison:
          <a href="/self-hosted-dmarc-monitoring/">self-hosted</a>,
          <a href="/free-dmarc-analyzer/">free</a>, and unmetered, because there's
          no vendor infrastructure whose cost has to be recovered per domain.
        </p>
        <p>
          That's a trade, not a free lunch: you run the server, and support is
          the <a href="https://github.com/dmarc-analyzer-net/DmarcAnalyzerApp">issue
          tracker</a> rather than an SLA. Each page above is honest about where
          the vendor-hosted option is genuinely the better fit — usually a single
          domain, a need for vendor support, or a wider bundled tool suite you'd
          rather not assemble yourself.
        </p>
      </div>
      <Cta />
    </section>
</BaseLayout>
