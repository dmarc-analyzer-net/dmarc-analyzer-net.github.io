---
/**
 * Browser chrome — traffic lights plus a mono URL — for presenting app screens
 * in marketing contexts. The design system names this the standard way to show
 * the product, since the brand uses no illustration or photography: the
 * "imagery" is the product itself.
 *
 * The screen goes in the default slot.
 */
interface Props {
  url?: string;
  /** Extra styles for the outer frame (margins, max-width). */
  style?: string;
}
const { url = 'app.dmarc-analyzer.net', style = '' } = Astro.props;

// Traffic lights are decorative and carry no information, so they sit below the
// 3:1 graphics threshold on purpose — they are recognised by arrangement, not
// by colour, and the frame is inert.
const LIGHTS = ['#f26d6d', '#f2b93d', '#3fc98a'];
---

<div
  style={`border:1px solid var(--teal-100); border-radius:var(--radius-lg); background:var(--surface-card); overflow:hidden; box-shadow:var(--shadow-raised); ${style}`}
>
  <div
    style="display:flex; align-items:center; gap:14px; padding:12px 18px; border-bottom:1px solid var(--teal-100); background:var(--teal-50);"
  >
    <div style="display:flex; gap:7px;" aria-hidden="true">
      {LIGHTS.map((c) => <span style={`width:11px; height:11px; border-radius:var(--radius-pill); background:${c};`}></span>)}
    </div>
    <div class="mono" style="font-size:var(--text-xs); color:var(--link);">{url}</div>
  </div>
  <slot />
</div>
