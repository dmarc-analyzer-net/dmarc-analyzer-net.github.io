      <!-- HOW IT WORKS -->
      <section id="how" style="background:var(--teal-50); border-top:1px solid var(--border-strong); border-bottom:1px solid var(--border-strong);">
        <div style="max-width:1160px; margin:0 auto; padding:64px 32px;">
          <div style="max-width:620px; margin-bottom:44px;">
            <div style="font-size:var(--text-sm); font-weight:600; color:var(--brand); margin-bottom:12px;">How it works</div>
            <h2 style="font-size:38px; line-height:1.08; letter-spacing:-0.02em; font-weight:600; margin:0 0 16px;">From raw XML to enforced in three steps.</h2>
            <p style="font-size:var(--text-body-lg); line-height:1.5; color:var(--gray-700); margin:0;">The pipeline runs continuously in the background. You just watch compliance climb.</p>
          </div>
          <div class="grid-3" style="display:grid; grid-template-columns:repeat(3,1fr); gap:16px;">
            <div style="border:1px solid var(--border-strong); border-radius:var(--radius-lg); background:var(--surface-card); padding:26px;">
              <div style="display:flex; align-items:center; gap:12px; margin-bottom:16px;"><span class="mono" style="font-size:var(--text-xs); font-weight:600; color:var(--brand);">01</span><span style="flex:1; height:1px; background:var(--border-strong);"></span><Icon name="inbox" style="font-size:20px; color:var(--brand);" /></div>
              <h3 style="font-size:17px; font-weight:600; margin:0 0 8px; letter-spacing:-0.01em;">Sync the mailbox</h3>
              <p style="font-size:var(--text-base); line-height:1.55; color:var(--gray-700); margin:0;">Publish a DMARC record pointing report addresses at your inbox, then connect that mailbox once. Reports arrive automatically from every mailbox provider.</p>
            </div>
            <div style="border:1px solid var(--border-strong); border-radius:var(--radius-lg); background:var(--surface-card); padding:26px;">
              <div style="display:flex; align-items:center; gap:12px; margin-bottom:16px;"><span class="mono" style="font-size:var(--text-xs); font-weight:600; color:var(--brand);">02</span><span style="flex:1; height:1px; background:var(--border-strong);"></span><Icon name="funnel" style="font-size:20px; color:var(--brand);" /></div>
              <h3 style="font-size:17px; font-weight:600; margin:0 0 8px; letter-spacing:-0.01em;">Parse &amp; align</h3>
              <p style="font-size:var(--text-base); line-height:1.55; color:var(--gray-700); margin:0;">The worker unpacks each report, resolves sending sources, and checks SPF and DKIM alignment — grouping thousands of rows into a handful of clear signals.</p>
            </div>
            <div style="border:1px solid var(--border-strong); border-radius:var(--radius-lg); background:var(--surface-card); padding:26px;">
              <div style="display:flex; align-items:center; gap:12px; margin-bottom:16px;"><span class="mono" style="font-size:var(--text-xs); font-weight:600; color:var(--brand);">03</span><span style="flex:1; height:1px; background:var(--border-strong);"></span><Icon name="layout-dashboard" style="font-size:20px; color:var(--brand);" /></div>
              <h3 style="font-size:17px; font-weight:600; margin:0 0 8px; letter-spacing:-0.01em;">Monitor &amp; enforce</h3>
              <p style="font-size:var(--text-base); line-height:1.55; color:var(--gray-700); margin:0;">Every domain gets a live compliance score, a threat feed, and a recommended next policy change. Tighten from none to reject with confidence.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- QUICK START -->
      <section id="quickstart" style="max-width:1160px; margin:0 auto; padding:64px 32px;">
        <div class="split" style="display:grid; grid-template-columns:0.9fr 1.1fr; gap:48px; align-items:center;">
