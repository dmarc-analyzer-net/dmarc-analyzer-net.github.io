---
import Icon from './Icon.astro';

interface Props {
  /** Which page is active, so its nav link gets the highlighted treatment. */
  current?: 'home' | 'features' | 'guides' | 'glossary' | 'setup' | 'compare' | 'tools' | 'docs';
}
const { current } = Astro.props;

// Repo for the actual application (the marketing site links out to it).
const GH = 'https://github.com/dmarc-analyzer-net/DmarcAnalyzerApp';
---
<header style="position:sticky; top:0; z-index:50; background:rgba(247,251,249,0.85); backdrop-filter:blur(10px); border-bottom:1px solid var(--border-default);">
  <nav style="max-width:1160px; margin:0 auto; padding:14px 32px; display:flex; align-items:center; justify-content:space-between; gap:24px;">
    <a href="/" style="display:flex; align-items:center; gap:10px; color:var(--text-body) !important;">
      <span style="width:30px; height:30px; border-radius:8px; background:linear-gradient(135deg,#0d9488,#115e59); display:flex; align-items:center; justify-content:center;">
        <Icon name="shield-energy" style="font-size:17px; color:var(--teal-50);" />
      </span>
      <span style="font-family:'Space Grotesk',sans-serif; font-size:16.5px; font-weight:600; letter-spacing:-0.01em;">DMARC Analyzer</span>
    </a>
    <div style="display:flex; align-items:center; gap:28px;">
      {current === 'features' ? (
        <a href="/features" style="font-size:14px; font-weight:600; color:var(--brand) !important;">Features</a>
      ) : (
        <a class="navlink" href="/features" style="font-size:14px; font-weight:500;">Features</a>
      )}
      {current === 'guides' ? (
        <a href="/guides" style="font-size:14px; font-weight:600; color:var(--brand) !important;">Guides</a>
      ) : (
        <a class="navlink" href="/guides" style="font-size:14px; font-weight:500;">Guides</a>
      )}
      {current === 'glossary' ? (
        <a href="/glossary" style="font-size:14px; font-weight:600; color:var(--brand) !important;">Glossary</a>
      ) : (
        <a class="navlink" href="/glossary" style="font-size:14px; font-weight:500;">Glossary</a>
      )}
      {current === 'setup' ? (
        <a href="/dmarc-for" style="font-size:14px; font-weight:600; color:var(--brand) !important;">Setup</a>
      ) : (
        <a class="navlink" href="/dmarc-for" style="font-size:14px; font-weight:500;">Setup</a>
      )}
      {current === 'compare' ? (
        <a href="/compare" style="font-size:14px; font-weight:600; color:var(--brand) !important;">Compare</a>
      ) : (
        <a class="navlink" href="/compare" style="font-size:14px; font-weight:500;">Compare</a>
      )}
      {current === 'tools' ? (
        <a href="/tools" style="font-size:14px; font-weight:600; color:var(--brand) !important;">Tools</a>
      ) : (
        <a class="navlink" href="/tools" style="font-size:14px; font-weight:500;">Tools</a>
      )}
      <a class="navlink" href="/#how" style="font-size:14px; font-weight:500;">How it works</a>
      {current === 'docs' ? (
        <a href="/docs" style="font-size:14px; font-weight:600; color:var(--brand) !important;">Docs</a>
      ) : (
        <a class="navlink" href="/docs" style="font-size:14px; font-weight:500;">Docs</a>
      )}
    </div>
    <div style="display:flex; align-items:center; gap:12px;">
      <a class="btn-ghost" href={GH} style="display:inline-flex; align-items:center; gap:7px; height:34px; padding:0 13px; border:1px solid var(--border-strong); border-radius:8px; background:var(--surface-card); color:var(--text-body) !important; font-size:13px; font-weight:500;">
        <Icon name="github" style="font-size:15px;" /> Star on GitHub
      </a>
      <a class="btn-primary" href="/#quickstart" style="display:inline-flex; align-items:center; height:34px; padding:0 15px; border-radius:8px; background:var(--brand); color:var(--teal-50) !important; font-size:13px; font-weight:600;">Get started</a>
    </div>
  </nav>
</header>
