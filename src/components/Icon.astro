    class={className}
    style={`width:1em;height:1em;display:inline-block;vertical-align:middle;flex-shrink:0;${style ?? ""}`}
    viewBox="0 0 1000 1000"
    role={title ? "img" : undefined}
    aria-hidden={title ? undefined : "true"}
    focusable="false"
  >
    {title && <title>{title}</title>}
    <path d={d} transform="matrix(1 0 0 -1 0 1000)" fill="currentColor" />
  </svg>
)}
