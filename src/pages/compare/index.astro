---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';

const entries = (await getCollection('compare', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.competitor.localeCompare(b.data.competitor),
);
---
<BaseLayout
  title="Compare DMARC Analyzer to the alternatives"
  description="How an open-source, self-hosted DMARC analyzer compares to dmarcian, EasyDMARC, PowerDMARC, Valimail, and parsedmarc — on hosting, pricing, and data ownership."
  path="/compare"
>
  <div style="min-height:100vh;">
    <Header current="compare" />
    <section style="background:radial-gradient(800px 360px at 20% -20%, rgba(20,184,166,0.13), transparent 65%);">
      <div style="max-width:960px; margin:0 auto; padding:72px 32px 32px;">
        <div style="font-size:13px; font-weight:600; color:#0d9488; margin-bottom:14px;">Compare</div>
        <h1 style="font-family:'Space Grotesk',sans-serif; font-size:44px; line-height:1.06; letter-spacing:-0.03em; font-weight:600; margin:0 0 18px; max-width:740px;">Honest comparisons — hosting, pricing, and who owns your data.</h1>
        <p style="font-size:18px; line-height:1.5; color:#425551; margin:0; max-width:640px;">Every commercial DMARC platform is cloud-only and priced per domain. Here's how a self-hosted, open-source analyzer stacks up against each — and where each alternative genuinely fits.</p>
      </div>
    </section>
    <section style="max-width:960px; margin:0 auto; padding:32px 32px 72px;">
      <ul style="list-style:none; margin:0; padding:0; display:grid; grid-template-columns:repeat(auto-fill,minmax(280px,1fr)); gap:16px;">
        {entries.map((e) => (
          <li>
            <a class="lift" href={`/compare/${e.id}`} style="display:block; height:100%; border:1px solid #c8ded7; border-radius:14px; background:#ffffff; padding:22px 24px; color:#0c1a18 !important;">
              <h2 style="font-size:18px; font-weight:600; letter-spacing:-0.01em; margin:0 0 8px; display:flex; align-items:center; justify-content:space-between; gap:12px;">
                vs {e.data.competitor}
                <Icon name="arrow-right-01" style="font-size:17px; color:#0d9488;" />
              </h2>
              <p style="font-size:14px; line-height:1.55; color:#425551; margin:0;">{e.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
    <Footer />
  </div>
</BaseLayout>
