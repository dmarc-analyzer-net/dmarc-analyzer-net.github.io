---
import Icon from './Icon.astro';

// Closing call-to-action band for content pages (guides, provider setup).
// Funnels educational traffic to the product. Glossary pages intentionally
// omit this (they stay lean — see the content style guide). Override the copy
// per page via props when a more specific hook fits.
interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Own your DMARC data',
  text = 'DMARC Analyzer is open source and self-hosted — monitor unlimited domains and keep every report on your own infrastructure. No per-domain fees.',
} = Astro.props;

// The application repo (the marketing site links out to it).
const GH = 'https://github.com/dmarc-analyzer-net/DmarcAnalyzerApp';
---
<aside class="ink-panel" style="margin-top:48px; border-radius:var(--radius-lg); background:linear-gradient(135deg,var(--surface-ink),var(--ink-700)); border:1px solid var(--border-on-ink); padding:32px 34px;">
  <h2 style="font-family:'Space Grotesk',sans-serif; font-size:var(--text-xl); font-weight:600; letter-spacing:-0.02em; color:var(--teal-50); margin:0 0 8px;">{title}</h2>
  <p style="font-size:var(--text-md); line-height:1.6; color:var(--text-on-ink-muted); margin:0 0 22px; max-width:560px;">{text}</p>
  <div style="display:flex; flex-wrap:wrap; gap:12px;">
    <a class="btn-mint" href="/#quickstart" style="display:inline-flex; align-items:center; height:40px; padding:0 18px; border-radius:var(--radius-md); background:var(--mint-400); color:var(--surface-ink) !important; font-size:var(--text-base); font-weight:600;">Get started</a>
    <a href={GH} style="display:inline-flex; align-items:center; gap:8px; height:40px; padding:0 16px; border:1px solid rgba(255,255,255,0.22); border-radius:var(--radius-md); background:transparent; color:var(--text-on-ink) !important; font-size:var(--text-base); font-weight:500;"><Icon name="github" style="font-size:16px;" /> View on GitHub</a>
  </div>
</aside>
