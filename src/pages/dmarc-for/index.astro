---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';

const providers = (await getCollection('providers', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.provider.localeCompare(b.data.provider),
);
---
<BaseLayout current="setup"
  title="Set up DMARC for your email provider — DMARC Analyzer"
  description="Step-by-step SPF, DKIM, and DMARC setup guides for Google Workspace, Microsoft 365, GoDaddy, and more — with the provider-specific gotchas that trip people up."
  path="/dmarc-for"
>
    <section style="background:radial-gradient(800px 360px at 20% -20%, rgba(20,184,166,0.13), transparent 65%);">
      <div style="max-width:960px; margin:0 auto; padding:72px 32px 32px;">
        <div style="font-size:var(--text-sm); font-weight:600; color:var(--brand); margin-bottom:14px;">DMARC setup</div>
        <h1 style="font-family:'Space Grotesk',sans-serif; font-size:44px; line-height:1.06; letter-spacing:-0.03em; font-weight:600; margin:0 0 18px; max-width:720px;">Set up SPF, DKIM & DMARC for your provider.</h1>
        <p style="font-size:var(--text-lg); line-height:1.5; color:var(--gray-700); margin:0; max-width:620px;">Exact records and steps for each email platform — including where each one sends reports from and the gotchas that quietly break authentication.</p>
      </div>
    </section>
    <section style="max-width:960px; margin:0 auto; padding:32px 32px 72px;">
      <ul style="list-style:none; margin:0; padding:0; display:grid; grid-template-columns:repeat(auto-fill,minmax(280px,1fr)); gap:16px;">
        {providers.map((p) => (
          <li>
            <a class="lift" href={`/dmarc-for/${p.id}`} style="display:block; height:100%; border:1px solid var(--border-strong); border-radius:var(--radius-lg); background:var(--surface-card); padding:22px 24px; color:var(--text-body) !important;">
              <h2 style="font-size:var(--text-lg); font-weight:600; letter-spacing:-0.01em; margin:0 0 8px; display:flex; align-items:center; justify-content:space-between; gap:12px;">
                {p.data.provider}
                <Icon name="arrow-right" style="font-size:17px; color:var(--brand);" />
              </h2>
              <p style="font-size:var(--text-base); line-height:1.55; color:var(--gray-700); margin:0;">{p.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
</BaseLayout>
