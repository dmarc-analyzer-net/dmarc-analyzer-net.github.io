---
import Icon from './Icon.astro';

/**
 * Ink-dark terminal block for marketing quick-starts.
 *
 * `cmd` lines auto-prefix a mint `$`; `ok` lines auto-prefix `✓`; `gap` draws a
 * blank spacer row for grouping commands into stanzas. Callers pass data rather
 * than markup, so every terminal shares one set of colours — previously this
 * was ~20 lines of inline styles living only on the homepage, and they had
 * already drifted: the header label sat at 2.73:1 against the panel behind it.
 *
 * Colours come from the design tokens in global.css rather than literals, so
 * `--surface-ink`, `--mint-400` and friends stay the single source of truth.
 *
 * Long clone URLs wrap via `overflow-wrap` rather than a `<wbr>`, so nothing
 * extra lands in the clipboard when a line is copied.
 */
export type TerminalLineType = 'comment' | 'cmd' | 'ok' | 'out' | 'gap';

export interface TerminalLine {
  type: TerminalLineType;
  /** Omitted for `gap`. */
  text?: string;
  /**
   * What the copy button puts on the clipboard for this line, when the
   * displayed text is abbreviated to fit. A long raw.githubusercontent.com URL
   * shown as `https://…/deploy/compose.yml` is readable but not runnable, and
   * the clipboard must carry the version that runs.
   */
  copyText?: string;
}

interface Props {
  title?: string;
  lines: TerminalLine[];
}

const { title = 'Terminal', lines } = Astro.props;

// Only the commands. Comments, output and `ok` lines are context for reading,
// not something anyone wants pasted into a shell — and the `$` prefix is
// decoration this component adds, so it must not travel with the text.
const commands = lines
  .filter((line) => line.type === 'cmd')
  .map((line) => line.copyText ?? line.text ?? '')
  .filter(Boolean)
  .join('\n');

const TONE: Record<string, string> = {
  comment: 'var(--text-on-ink-muted)',
  cmd: 'var(--text-on-ink)',
  ok: 'var(--mint-400)',
  out: 'var(--amber-500)',
};
---

<div
  style="border:1px solid var(--border-on-ink); border-radius:var(--radius-lg); background:var(--surface-ink); overflow:hidden; box-shadow:var(--shadow-ink-panel);"
>
  <div
    style="display:flex; align-items:center; justify-content:space-between; padding:11px 15px; border-bottom:1px solid var(--border-on-ink); background:var(--surface-ink-raised);"
  >
    <span class="mono" style="font-size:var(--text-xs); color:var(--text-on-ink-muted);">{title}</span>
    {commands && (
      <button
        type="button"
        data-copy={commands}
        aria-label="Copy the commands from this terminal"
        class="mono"
        style="display:inline-flex; align-items:center; gap:6px; border:0; background:transparent; padding:0; cursor:pointer; font-size:var(--text-xs); color:var(--text-on-ink-muted);"
      >
        <Icon name="copy" style="font-size:var(--text-base);" />
        <span data-copy-label>Copy</span>
      </button>
    )}
  </div>
  <div class="mono" style="padding:20px; font-size:var(--text-sm); line-height:1.9; color:var(--text-on-ink);">
    {
      lines.map((line) =>
        line.type === 'gap' ? (
          <div style="height:12px;" />
        ) : (
          <div style={`color:${TONE[line.type]}; overflow-wrap:anywhere;`}>
            {line.type === 'cmd' && <span style="color:var(--mint-400); margin-right:8px;">$</span>}
            {line.type === 'ok' && <span style="margin-right:8px;">✓</span>}
            {line.text}
          </div>
        ),
      )
    }
  </div>
</div>

<script>
  // Astro hoists and dedupes this, so a page with several terminals still
  // loads it once, and it also covers the hero button on the homepage.
  import { wireCopyButtons } from '../lib/clipboard';
  wireCopyButtons();
</script>
