---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import BrowserFrame from '../components/BrowserFrame.astro';
import Terminal from '../components/Terminal.astro';
import JsonLd from '../components/JsonLd.astro';

const title = 'DMARC Analyzer — Open-source DMARC monitoring for agencies';
const description =
  'Open-source, self-hosted DMARC monitoring for agencies running many client domains. Catch spoofing and reach enforcement, with no per-domain fees.';

const GH = 'https://github.com/dmarc-analyzer-net/DmarcAnalyzerApp';
const siteUrl = Astro.site?.href ?? 'https://dmarc-analyzer-net.github.io/';

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'DMARC Analyzer',
  url: siteUrl,
  description: 'Open-source, self-hosted DMARC monitoring for agencies.',
  sameAs: ['https://github.com/dmarc-analyzer-net'],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'DMARC Analyzer',
  url: siteUrl,
};

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'DMARC Analyzer',
  applicationCategory: 'SecurityApplication',
  operatingSystem: 'Docker, Linux',
  description,
  url: GH,
  license: 'https://www.apache.org/licenses/LICENSE-2.0',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

// Mirror of the on-page FAQ below; keep in sync if the questions change.
const faqs = [
  ['What is DMARC, in one sentence?', 'DMARC is an email standard that lets a domain owner tell receiving servers what to do with mail that fails authentication — monitor it, quarantine it, or reject it — and get reports on who is sending as their domain. It is how you stop others from spoofing your clients’ brands.'],
  ['Why run it myself instead of a hosted tool?', 'Cost and control. Hosted platforms bill per domain and per message, so an agency with dozens of clients pays the most. Self-hosting removes that ceiling, keeps sensitive report data on your own infrastructure, and lets you customise the tool to your workflow.'],
  ['How many domains can it handle?', 'There is no built-in limit. Domains are grouped by client, and the background worker scales with your database — the same install comfortably serves a handful of domains or several hundred across many clients.'],
  ['What do I need to run it?', 'For production, Docker and a PostgreSQL database (both included in the compose file) plus a mailbox that receives your DMARC reports. For local development, .NET SDK 10 and Node.js 22+ give you hot reload on both the API and the frontend.'],
  ['Is it really free?', 'Yes. The project is released under the Apache-2.0 licence — free to use, modify, and deploy commercially. You pay only for the infrastructure you run it on.'],
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(([q, a]) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---
<BaseLayout title={title} description={description} path="/">
  <JsonLd slot="head" schema={orgSchema} />
  <JsonLd slot="head" schema={websiteSchema} />
  <JsonLd slot="head" schema={appSchema} />
  <JsonLd slot="head" schema={faqSchema} />
  <div style="min-height:100vh; width:100%;">
    <Header current="home" />
    <a id="top"></a>

      <!-- HERO -->
      <section style="background:radial-gradient(900px 420px at 18% -10%, rgba(20,184,166,0.14), transparent 65%), radial-gradient(700px 380px at 85% 5%, rgba(217,119,6,0.07), transparent 60%);">
        <div style="max-width:1160px; margin:0 auto; padding:84px 32px 32px;">
          <div style="display:inline-flex; align-items:center; gap:8px; padding:5px 12px 5px 8px; border:1px solid #b9e3da; border-radius:999px; background:#ffffff; margin-bottom:28px;">
            <span style="display:inline-flex; width:18px; height:18px; border-radius:999px; background:#ccfbf1; align-items:center; justify-content:center;"><Icon name="unlocked" style="font-size:11px; color:#0c7568;" /></span>
            <span style="font-size:12.5px; font-weight:500; color:#0c7568;">Open source · Apache-2.0 · Self-hosted</span>
          </div>
          <h1 style="font-size:58px; line-height:1.03; letter-spacing:-0.03em; font-weight:600; margin:0 0 22px; max-width:860px;">DMARC monitoring built for agencies running <span style="color:#0c7568;">many domains</span>.</h1>
          <p style="font-size:19px; line-height:1.5; color:#425551; margin:0 0 34px; max-width:640px;">See every client's email authentication in one place. Ingest DMARC reports, spot spoofing and misconfiguration, and move each domain to full enforcement — without paying per-domain for a closed platform.</p>
          <div style="display:flex; align-items:center; gap:12px; flex-wrap:wrap; margin-bottom:18px;">
            <a class="btn-primary" href="#quickstart" style="display:inline-flex; align-items:center; gap:8px; height:44px; padding:0 20px; border-radius:10px; background:#0c7568; color:#f0fdfa !important; font-size:15px; font-weight:600;">
              <Icon name="rocket-01" style="font-size:17px;" /> Get started
            </a>
            <a class="btn-ghost" href="https://github.com/dmarc-analyzer-net/DmarcAnalyzerApp" style="display:inline-flex; align-items:center; gap:8px; height:44px; padding:0 18px; border:1px solid #c8ded7; border-radius:10px; background:#ffffff; color:#0c1a18 !important; font-size:15px; font-weight:500;">
              <Icon name="github" style="font-size:17px;" /> View on GitHub
            </a>
          </div>
          <div class="mono" style="display:inline-flex; align-items:center; gap:10px; font-size:13px; color:#3f5450; background:#eaf6f2; border:1px solid #c8e6dd; border-radius:8px; padding:9px 13px;">
            <span style="color:#0c7568;">$</span> docker compose up -d --build
            <span style="width:1px; height:14px; background:#b9e3da;"></span>
            <Icon name="copy-01" style="font-size:14px; color:#5d726d;" />
          </div>
        </div>
      </section>

      <!-- DASHBOARD MOCKUP -->
      <section style="max-width:1160px; margin:0 auto; padding:24px 32px 40px;">
        <BrowserFrame url="app.dmarc-analyzer.net / overview">
          <div style="display:flex;">
            <aside style="width:214px; flex-shrink:0; border-right:1px solid #dcebe5; background:#f2f9f6; padding:16px 12px; display:flex; flex-direction:column; gap:2px;">
              <div style="font-size:11px; font-weight:500; color:#5d726d; padding:4px 10px 6px;">Agency workspace</div>
              <div style="display:flex; align-items:center; gap:9px; padding:8px 10px; border-radius:7px; background:#ccfbf1; font-size:13px; font-weight:600; color:#0b5d54;"><Icon name="dashboard-square-02" style="font-size:15px;" /> Overview</div>
              <div style="display:flex; align-items:center; gap:9px; padding:8px 10px; border-radius:7px; font-size:13px; color:#425551;"><Icon name="globe-02" style="font-size:15px;" /> Domains <span style="margin-left:auto; font-size:11px; color:#5d726d;">42</span></div>
              <div style="display:flex; align-items:center; gap:9px; padding:8px 10px; border-radius:7px; font-size:13px; color:#425551;"><Icon name="mail-02" style="font-size:15px;" /> Reports</div>
              <div style="display:flex; align-items:center; gap:9px; padding:8px 10px; border-radius:7px; font-size:13px; color:#425551;"><Icon name="alert-02" style="font-size:15px;" /> Threats <span style="margin-left:auto; font-size:11px; font-weight:600; color:#be123c;">7</span></div>
              <div style="display:flex; align-items:center; gap:9px; padding:8px 10px; border-radius:7px; font-size:13px; color:#425551;"><Icon name="user-group" style="font-size:15px;" /> Clients</div>
              <div style="margin-top:auto; display:flex; align-items:center; gap:9px; padding:8px 10px; border-radius:7px; font-size:13px; color:#425551;"><Icon name="settings-02" style="font-size:15px;" /> Settings</div>
            </aside>
            <div style="flex:1; min-width:0; padding:22px 24px;">
              <div style="display:flex; align-items:flex-start; justify-content:space-between; gap:16px; margin-bottom:20px;">
                <div>
                  <div style="font-family:'Space Grotesk',sans-serif; font-size:18px; font-weight:600; letter-spacing:-0.01em;">All domains</div>
                  <div style="font-size:13px; color:#5d726d; margin-top:2px;">42 monitored · synced 4 minutes ago · 3 need attention</div>
                </div>
                <div style="display:flex; gap:8px;">
                  <span style="display:inline-flex; align-items:center; height:30px; padding:0 12px; border:1px solid #c8ded7; border-radius:7px; font-size:12.5px; color:#425551; background:#ffffff;">Last 30 days</span>
                  <span style="display:inline-flex; align-items:center; gap:6px; height:30px; padding:0 12px; border-radius:7px; font-size:12.5px; font-weight:600; color:#f0fdfa; background:#0c7568;"><Icon name="add-01" style="font-size:13px;" /> Add domain</span>
                </div>
              </div>
              <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:12px; margin-bottom:18px;">
                <div style="border:1px solid #dcebe5; border-radius:11px; padding:14px 15px; background:#ffffff;">
                  <div style="font-size:12px; color:#5d726d; margin-bottom:8px;">Domains monitored</div>
                  <div style="font-family:'Space Grotesk',sans-serif; font-size:26px; font-weight:700; letter-spacing:-0.02em; font-variant-numeric:tabular-nums;">42</div>
                </div>
                <div style="border:1px solid #dcebe5; border-radius:11px; padding:14px 15px; background:#ffffff;">
                  <div style="font-size:12px; color:#5d726d; margin-bottom:8px;">DMARC compliance</div>
                  <div style="display:flex; align-items:baseline; gap:7px;"><span style="font-family:'Space Grotesk',sans-serif; font-size:26px; font-weight:700; letter-spacing:-0.02em; font-variant-numeric:tabular-nums; color:#0c7568;">96.2%</span><span style="font-size:11px; font-weight:600; color:#0c7568; background:#ccfbf1; border-radius:5px; padding:2px 5px;">+2.4pp</span></div>
                </div>
                <div style="border:1px solid #dcebe5; border-radius:11px; padding:14px 15px; background:#ffffff;">
                  <div style="font-size:12px; color:#5d726d; margin-bottom:8px;">Messages analyzed</div>
                  <div style="display:flex; align-items:flex-end; justify-content:space-between; gap:8px;">
                    <span style="font-family:'Space Grotesk',sans-serif; font-size:26px; font-weight:700; letter-spacing:-0.02em; font-variant-numeric:tabular-nums;">1.24M</span>
                    <span style="display:inline-flex; align-items:flex-end; gap:2px; height:26px;">
                      <span style="width:5px; height:10px; border-radius:2px; background:#99f6e4;"></span>
                      <span style="width:5px; height:14px; border-radius:2px; background:#5eead4;"></span>
                      <span style="width:5px; height:11px; border-radius:2px; background:#99f6e4;"></span>
                      <span style="width:5px; height:18px; border-radius:2px; background:#2dd4bf;"></span>
                      <span style="width:5px; height:15px; border-radius:2px; background:#5eead4;"></span>
                      <span style="width:5px; height:22px; border-radius:2px; background:#14b8a6;"></span>
                      <span style="width:5px; height:26px; border-radius:2px; background:#0d9488;"></span>
                    </span>
                  </div>
                </div>
                <div style="border:1px solid #dcebe5; border-radius:11px; padding:14px 15px; background:#ffffff;">
                  <div style="font-size:12px; color:#5d726d; margin-bottom:8px;">Spoofing blocked</div>
                  <div style="display:flex; align-items:baseline; gap:7px;"><span style="font-family:'Space Grotesk',sans-serif; font-size:26px; font-weight:700; letter-spacing:-0.02em; font-variant-numeric:tabular-nums;">3,481</span><span style="font-size:11px; font-weight:600; color:#be123c; background:#ffe4e6; border-radius:5px; padding:2px 5px;">7 active</span></div>
                </div>
              </div>
              <div style="border:1px solid #dcebe5; border-radius:11px; overflow:hidden;">
                <div style="display:grid; grid-template-columns:1.6fr 1fr 1.3fr 0.8fr; gap:12px; padding:10px 16px; background:#f2f9f6; border-bottom:1px solid #dcebe5; font-size:11px; font-weight:500; color:#5d726d;">
                  <span>Domain</span><span>Policy</span><span>Compliance</span><span style="text-align:right;">Status</span>
                </div>
                <div class="row-hover" style="display:grid; grid-template-columns:1.6fr 1fr 1.3fr 0.8fr; gap:12px; align-items:center; padding:12px 16px; border-bottom:1px solid #e8f2ee;">
                  <div style="display:flex; align-items:center; gap:9px;"><span style="width:8px; height:8px; border-radius:999px; background:#0d9488;"></span><span class="mono" style="font-size:13px;">northgate-agency.com</span></div>
                  <span class="mono" style="font-size:12px; color:#0c7568; background:#ccfbf1; justify-self:start; padding:2px 7px; border-radius:5px;">p=reject</span>
                  <div style="display:flex; align-items:center; gap:9px;"><div style="flex:1; height:6px; border-radius:999px; background:#e8f2ee; overflow:hidden;"><div style="width:99%; height:100%; background:#0d9488;"></div></div><span style="font-size:12px; color:#5d726d; font-variant-numeric:tabular-nums; width:36px; text-align:right;">99%</span></div>
                  <span style="justify-self:end; font-size:11px; font-weight:600; color:#0c7568; background:#ccfbf1; padding:3px 9px; border-radius:999px;">Enforced</span>
                </div>
                <div class="row-hover" style="display:grid; grid-template-columns:1.6fr 1fr 1.3fr 0.8fr; gap:12px; align-items:center; padding:12px 16px; border-bottom:1px solid #e8f2ee;">
                  <div style="display:flex; align-items:center; gap:9px;"><span style="width:8px; height:8px; border-radius:999px; background:#d97706;"></span><span class="mono" style="font-size:13px;">clientmail.co</span></div>
                  <span class="mono" style="font-size:12px; color:#b45309; background:#fef3c7; justify-self:start; padding:2px 7px; border-radius:5px;">p=quarantine</span>
                  <div style="display:flex; align-items:center; gap:9px;"><div style="flex:1; height:6px; border-radius:999px; background:#e8f2ee; overflow:hidden;"><div style="width:87%; height:100%; background:#f59e0b;"></div></div><span style="font-size:12px; color:#5d726d; font-variant-numeric:tabular-nums; width:36px; text-align:right;">87%</span></div>
                  <span style="justify-self:end; font-size:11px; font-weight:600; color:#b45309; background:#fef3c7; padding:3px 9px; border-radius:999px;">Ramping</span>
                </div>
                <div class="row-hover" style="display:grid; grid-template-columns:1.6fr 1fr 1.3fr 0.8fr; gap:12px; align-items:center; padding:12px 16px; border-bottom:1px solid #e8f2ee;">
                  <div style="display:flex; align-items:center; gap:9px;"><span style="width:8px; height:8px; border-radius:999px; background:#e11d48;"></span><span class="mono" style="font-size:13px;">acme-retail.com</span></div>
                  <span class="mono" style="font-size:12px; color:#425551; background:#e8f2ee; justify-self:start; padding:2px 7px; border-radius:5px;">p=none</span>
                  <div style="display:flex; align-items:center; gap:9px;"><div style="flex:1; height:6px; border-radius:999px; background:#e8f2ee; overflow:hidden;"><div style="width:61%; height:100%; background:#e11d48;"></div></div><span style="font-size:12px; color:#5d726d; font-variant-numeric:tabular-nums; width:36px; text-align:right;">61%</span></div>
                  <span style="justify-self:end; font-size:11px; font-weight:600; color:#be123c; background:#ffe4e6; padding:3px 9px; border-radius:999px;">Spoofing</span>
                </div>
                <div class="row-hover" style="display:grid; grid-template-columns:1.6fr 1fr 1.3fr 0.8fr; gap:12px; align-items:center; padding:12px 16px;">
                  <div style="display:flex; align-items:center; gap:9px;"><span style="width:8px; height:8px; border-radius:999px; background:#0d9488;"></span><span class="mono" style="font-size:13px;">harbor-logistics.io</span></div>
                  <span class="mono" style="font-size:12px; color:#0c7568; background:#ccfbf1; justify-self:start; padding:2px 7px; border-radius:5px;">p=reject</span>
                  <div style="display:flex; align-items:center; gap:9px;"><div style="flex:1; height:6px; border-radius:999px; background:#e8f2ee; overflow:hidden;"><div style="width:100%; height:100%; background:#0d9488;"></div></div><span style="font-size:12px; color:#5d726d; font-variant-numeric:tabular-nums; width:36px; text-align:right;">100%</span></div>
                  <span style="justify-self:end; font-size:11px; font-weight:600; color:#0c7568; background:#ccfbf1; padding:3px 9px; border-radius:999px;">Enforced</span>
                </div>
              </div>
            </div>
          </div>
        </BrowserFrame>
      </section>

      <!-- TRUST STRIP -->
      <section style="max-width:1160px; margin:0 auto; padding:22px 32px 56px;">
        <div style="display:flex; align-items:center; justify-content:center; gap:36px; flex-wrap:wrap; font-size:13px; color:#5d726d;">
          <span>Parses reports from</span>
          <span class="mono" style="color:#425551;">Google Workspace</span>
          <span class="mono" style="color:#425551;">Microsoft 365</span>
          <span class="mono" style="color:#425551;">Yahoo</span>
          <span class="mono" style="color:#425551;">Mail.ru</span>
          <span class="mono" style="color:#425551;">Fastmail</span>
          <span class="mono" style="color:#425551;">+ any RFC-7489 sender</span>
        </div>
      </section>

      <!-- FEATURES -->
      <section id="features" style="max-width:1160px; margin:0 auto; padding:64px 32px; border-top:1px solid #dcebe5;">
        <div style="max-width:620px; margin-bottom:44px;">
          <div style="font-size:13px; font-weight:600; color:#0c7568; margin-bottom:12px;">Built for scale</div>
          <h2 style="font-size:38px; line-height:1.08; letter-spacing:-0.02em; font-weight:600; margin:0 0 16px;">Everything you need to run DMARC for a portfolio of clients.</h2>
          <p style="font-size:17px; line-height:1.5; color:#425551; margin:0;">One workspace, unlimited domains, no per-domain licensing. Purpose-built for the way agencies actually work.</p>
        </div>
        <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:16px;">
          <div class="lift" style="border:1px solid #c8ded7; border-radius:14px; background:#ffffff; padding:24px;">
            <span style="display:inline-flex; width:38px; height:38px; border-radius:10px; background:#ccfbf1; align-items:center; justify-content:center; margin-bottom:16px;"><Icon name="globe-02" style="font-size:19px; color:#0c7568;" /></span>
            <h3 style="font-size:17px; font-weight:600; margin:0 0 8px; letter-spacing:-0.01em;">Unlimited domains &amp; clients</h3>
            <p style="font-size:14px; line-height:1.55; color:#425551; margin:0;">Group domains by client, tag them, and give each account its own view. Add the 43rd domain at the same price as the first — zero.</p>
          </div>
          <div class="lift" style="border:1px solid #c8ded7; border-radius:14px; background:#ffffff; padding:24px;">
            <span style="display:inline-flex; width:38px; height:38px; border-radius:10px; background:#e0e7ff; align-items:center; justify-content:center; margin-bottom:16px;"><Icon name="mail-receive-02" style="font-size:19px; color:#4f46e5;" /></span>
            <h3 style="font-size:17px; font-weight:600; margin:0 0 8px; letter-spacing:-0.01em;">Automatic report ingestion</h3>
            <p style="font-size:14px; line-height:1.55; color:#425551; margin:0;">Point a mailbox at the tool. Aggregate and forensic XML reports are fetched, parsed, and de-duplicated on a schedule — no manual uploads.</p>
          </div>
          <div class="lift" style="border:1px solid #c8ded7; border-radius:14px; background:#ffffff; padding:24px;">
            <span style="display:inline-flex; width:38px; height:38px; border-radius:10px; background:#ffe4e6; align-items:center; justify-content:center; margin-bottom:16px;"><Icon name="alert-02" style="font-size:19px; color:#be123c;" /></span>
            <h3 style="font-size:17px; font-weight:600; margin:0 0 8px; letter-spacing:-0.01em;">Spoofing &amp; threat detection</h3>
            <p style="font-size:14px; line-height:1.55; color:#425551; margin:0;">Unauthenticated sources are surfaced the moment they appear, with the sending IP, volume, and geography so you can act before a client does.</p>
          </div>
          <div class="lift" style="border:1px solid #c8ded7; border-radius:14px; background:#ffffff; padding:24px;">
            <span style="display:inline-flex; width:38px; height:38px; border-radius:10px; background:#fef3c7; align-items:center; justify-content:center; margin-bottom:16px;"><Icon name="chart-line-data-02" style="font-size:19px; color:#b45309;" /></span>
            <h3 style="font-size:17px; font-weight:600; margin:0 0 8px; letter-spacing:-0.01em;">Guided path to enforcement</h3>
            <p style="font-size:14px; line-height:1.55; color:#425551; margin:0;">Each domain shows exactly what stands between p=none and p=reject, with source-by-source alignment for SPF and DKIM.</p>
          </div>
          <div class="lift" style="border:1px solid #c8ded7; border-radius:14px; background:#ffffff; padding:24px;">
            <span style="display:inline-flex; width:38px; height:38px; border-radius:10px; background:#fae8ff; align-items:center; justify-content:center; margin-bottom:16px;"><Icon name="file-export" style="font-size:19px; color:#a21caf;" /></span>
            <h3 style="font-size:17px; font-weight:600; margin:0 0 8px; letter-spacing:-0.01em;">White-label client reports</h3>
            <p style="font-size:14px; line-height:1.55; color:#425551; margin:0;">Export a clean monthly summary per domain — your logo, your colours — that a non-technical client can actually read.</p>
          </div>
          <div class="lift" style="border:1px solid #c8ded7; border-radius:14px; background:#ffffff; padding:24px;">
            <span style="display:inline-flex; width:38px; height:38px; border-radius:10px; background:#ecfccb; align-items:center; justify-content:center; margin-bottom:16px;"><Icon name="database-02" style="font-size:19px; color:#4d7c0f;" /></span>
            <h3 style="font-size:17px; font-weight:600; margin:0 0 8px; letter-spacing:-0.01em;">Self-hosted, your data</h3>
            <p style="font-size:14px; line-height:1.55; color:#425551; margin:0;">Runs as a single container with PostgreSQL. Client report data never leaves your infrastructure — a real answer for data-residency clauses.</p>
          </div>
        </div>
        <div style="margin-top:28px;">
          <a href="/features" style="display:inline-flex; align-items:center; gap:7px; font-size:14px; font-weight:600; color:#0c7568 !important;">See the full feature breakdown <Icon name="arrow-right-01" style="font-size:15px;" /></a>
        </div>
      </section>

      <!-- HOW IT WORKS -->
      <section id="how" style="background:#e8f5f1; border-top:1px solid #cde7de; border-bottom:1px solid #cde7de;">
        <div style="max-width:1160px; margin:0 auto; padding:64px 32px;">
          <div style="max-width:620px; margin-bottom:44px;">
            <div style="font-size:13px; font-weight:600; color:#0c7568; margin-bottom:12px;">How it works</div>
            <h2 style="font-size:38px; line-height:1.08; letter-spacing:-0.02em; font-weight:600; margin:0 0 16px;">From raw XML to enforced in three steps.</h2>
            <p style="font-size:17px; line-height:1.5; color:#425551; margin:0;">The pipeline runs continuously in the background. You just watch compliance climb.</p>
          </div>
          <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:16px;">
            <div style="border:1px solid #c8ded7; border-radius:14px; background:#ffffff; padding:26px;">
              <div style="display:flex; align-items:center; gap:12px; margin-bottom:16px;"><span class="mono" style="font-size:12px; font-weight:600; color:#0c7568;">01</span><span style="flex:1; height:1px; background:#cde7de;"></span><Icon name="mail-download-02" style="font-size:20px; color:#0c7568;" /></div>
              <h3 style="font-size:17px; font-weight:600; margin:0 0 8px; letter-spacing:-0.01em;">Sync the mailbox</h3>
              <p style="font-size:14px; line-height:1.55; color:#425551; margin:0;">Publish a DMARC record pointing report addresses at your inbox, then connect that mailbox once. Reports arrive automatically from every mailbox provider.</p>
            </div>
            <div style="border:1px solid #c8ded7; border-radius:14px; background:#ffffff; padding:26px;">
              <div style="display:flex; align-items:center; gap:12px; margin-bottom:16px;"><span class="mono" style="font-size:12px; font-weight:600; color:#0c7568;">02</span><span style="flex:1; height:1px; background:#cde7de;"></span><Icon name="filter-edit" style="font-size:20px; color:#0c7568;" /></div>
              <h3 style="font-size:17px; font-weight:600; margin:0 0 8px; letter-spacing:-0.01em;">Parse &amp; align</h3>
              <p style="font-size:14px; line-height:1.55; color:#425551; margin:0;">The worker unpacks each report, resolves sending sources, and checks SPF and DKIM alignment — grouping thousands of rows into a handful of clear signals.</p>
            </div>
            <div style="border:1px solid #c8ded7; border-radius:14px; background:#ffffff; padding:26px;">
              <div style="display:flex; align-items:center; gap:12px; margin-bottom:16px;"><span class="mono" style="font-size:12px; font-weight:600; color:#0c7568;">03</span><span style="flex:1; height:1px; background:#cde7de;"></span><Icon name="dashboard-square-02" style="font-size:20px; color:#0c7568;" /></div>
              <h3 style="font-size:17px; font-weight:600; margin:0 0 8px; letter-spacing:-0.01em;">Monitor &amp; enforce</h3>
              <p style="font-size:14px; line-height:1.55; color:#425551; margin:0;">Every domain gets a live compliance score, a threat feed, and a recommended next policy change. Tighten from none to reject with confidence.</p>
            </div>
          </div>
        </div>
      </section>

