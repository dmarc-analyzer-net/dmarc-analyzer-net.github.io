---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Cta from '../../components/Cta.astro';
import JsonLd from '../../components/JsonLd.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';

export const title = 'SPF record checker';
export const description =
  'Free SPF checker that expands every include and counts your DNS lookups against the limit of 10 — the ceiling that breaks SPF silently once you cross it.';
const path = '/tools/spf-checker/';
const image = '/open-graph/tools/spf-checker.png';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'SPF Record Checker',
  applicationCategory: 'SecurityApplication',
  operatingSystem: 'Any (web browser)',
  description,
  image: new URL(image, Astro.site).href,
  url: new URL(path, Astro.site).href,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---
<BaseLayout current="tools" title={`${title} — DMARC Analyzer`} description={description} path={path} image={image}>
  <JsonLd slot="head" schema={schema} />
    <section style="background:radial-gradient(800px 360px at 20% -20%, rgba(20,184,166,0.13), transparent 65%);">
      <div style="max-width:900px; margin:0 auto; padding:56px 32px 20px;">
        <Breadcrumbs items={[
          { label: 'Home', href: '/' },
          { label: 'Tools', href: '/tools/' },
          { label: 'SPF record checker', href: path },
        ]} />
        <h1 style="font-family:'Space Grotesk',sans-serif; font-size:42px; line-height:1.08; letter-spacing:-0.03em; font-weight:600; margin:20px 0 14px; max-width:720px;">SPF record checker</h1>
        <p style="font-size:var(--text-lg); line-height:1.5; color:var(--gray-700); margin:0; max-width:640px;">Expands every <code class="mono">include:</code> and counts your DNS lookups against the limit of 10. Cross it and SPF stops working — with no bounce, no warning, and a record that still looks correct.</p>
      </div>
    </section>

    <section style="max-width:900px; margin:0 auto; padding:28px 32px;">
      <div style="border:1px solid var(--border-strong); border-radius:var(--radius-lg); background:var(--surface-card); padding:24px;">
        <label for="domainInput" style="display:block; font-size:var(--text-sm); font-weight:600; color:var(--gray-800); margin-bottom:8px;">Domain</label>
        <div style="display:flex; flex-wrap:wrap; gap:10px;">
          <input id="domainInput" type="text" inputmode="url" autocomplete="off" autocapitalize="off" spellcheck="false"
            placeholder="yourdomain.com"
            style="flex:1 1 260px; min-width:0; height:40px; font-family:'JetBrains Mono',monospace; font-size:14px; padding:0 12px; border:1px solid var(--border-strong); border-radius:var(--radius-md); background:var(--surface-page); color:var(--gray-800);" />
          <button id="checkBtn" class="btn-primary" style="height:40px; padding:0 20px; border:0; border-radius:var(--radius-md); background:var(--brand); color:var(--teal-50); font-size:var(--text-base); font-weight:600; cursor:pointer;">Check</button>
          <button id="sampleBtn" class="btn-ghost" style="height:40px; padding:0 16px; border:1px solid var(--border-strong); border-radius:var(--radius-md); background:#fff; color:var(--text-body); font-size:var(--text-base); font-weight:500; cursor:pointer;">Try an example</button>
        </div>
        <p style="margin:12px 2px 0; font-size:12.5px; color:var(--text-faint);">Queries TXT records over DNS-over-HTTPS (Cloudflare, falling back to Google). Only the domain names being resolved are sent, to the resolver — never to us.</p>
      </div>

      <p id="errorMsg" style="display:none; margin:14px 2px 0; font-size:var(--text-base); color:var(--status-danger-fg);"></p>

      <div id="results" style="display:none; margin-top:28px;"></div>
    </section>

    <!-- SEO / explanatory content -->
    <section style="max-width:760px; margin:0 auto; padding:24px 32px 8px;">
      <div class="prose">
        <h2>The 10-lookup limit, and why it breaks things quietly</h2>
        <p>
          <a href="https://www.rfc-editor.org/rfc/rfc7208#section-4.6.4" rel="nofollow">RFC 7208 §4.6.4</a>
          caps an SPF evaluation at <strong>10 DNS-querying terms</strong>.
          <code>include</code>, <code>a</code>, <code>mx</code>, <code>ptr</code>,
          <code>exists</code> and the <code>redirect</code> modifier each cost
          one. <code>ip4</code>, <code>ip6</code> and <code>all</code> cost
          nothing.
        </p>
        <p>
          The count is not just your own record — it is everything your
          <code>include:</code> terms pull in, recursively. Adding one SaaS sender
          can add four or five lookups you never see, because they are inside
          <em>their</em> record.
        </p>
        <p>
          Cross the limit and the result is <code>permerror</code>. Receivers
          treat that as "SPF did not pass", so mail that authenticated perfectly
          well yesterday starts failing — and nothing tells you. No bounce
          mentions it. Your DNS is valid. The record looks exactly as it did when
          it worked. This is the single most common way a working SPF setup dies.
        </p>

        <h3>How this tool counts</h3>
        <p>
          It counts as if every term is evaluated, which is the worst case and
          also what receivers hit whenever no earlier mechanism matches. Real
          evaluation stops at the first match, so a passing message may use fewer
          — but you cannot rely on that, because a message from your last-listed
          sender walks the whole record.
        </p>
        <p>
          <code>include:</code> and <code>redirect=</code> are expanded and their
          contents counted. <code>a</code>, <code>mx</code>, <code>ptr</code> and
          <code>exists</code> are counted at one lookup each without being
          resolved — the count is what matters, and resolving them would not
          change it. Terms containing
          <a href="https://www.rfc-editor.org/rfc/rfc7208#section-7" rel="nofollow">macros</a>
          such as <code>%&#123;i&#125;</code> cannot be expanded without a specific sending
          IP, so they are counted and flagged rather than followed.
        </p>

        <h2>What to do when you are over</h2>
        <ul>
          <li><strong>Drop senders you no longer use.</strong> The usual cause is accumulation — a record nobody has audited since three vendors ago. This is free.</li>
          <li><strong>Replace an <code>include</code> with the <code>ip4</code> ranges behind it</strong>, where the vendor publishes stable ones. Trades a lookup for a maintenance burden: their IPs change and yours do not follow.</li>
          <li><strong>Use <code>a</code> or <code>mx</code> instead of an include</strong> where a sender is really just your own mail host.</li>
          <li><strong>Send vendor mail from a subdomain</strong> — <code>mail.yourdomain.com</code> with its own SPF record and its own budget of 10. This is the durable fix, and it also keeps a vendor breach off your main domain.</li>
        </ul>
        <p>
          What does <em>not</em> work is publishing a second SPF record.
          Two records is <code>permerror</code> too
          (<a href="https://www.rfc-editor.org/rfc/rfc7208#section-4.5" rel="nofollow">§4.5</a>),
          so splitting one long record in half breaks SPF entirely rather than
          halving anything.
        </p>

        <h2>SPF alone does not stop spoofing</h2>
        <p>
          SPF authorises <em>servers</em>, not the address a reader sees. It
          checks the envelope sender, which nobody looks at, and it survives
          neither forwarding nor mailing lists. That is why
          <a href="/glossary/dmarc/">DMARC</a> exists: it requires the
          SPF-authenticated domain to
          <a href="/glossary/dmarc-alignment/">align</a> with the visible
          <code>From:</code> address, and it lets you say what should happen when
          nothing aligns.
        </p>
        <p>
          Which is where this stops being a one-off check. Whether your SPF
          changes helped is a question only the daily
          <a href="/glossary/dmarc-aggregate-report/">aggregate reports</a>
          answer, per sending source, over time.
          <a href="/">DMARC Analyzer</a> collects and reads those for you —
          <a href="/free-dmarc-analyzer/">free and open source</a>, and
          <a href="/self-hosted-dmarc-monitoring/">self-hosted</a>, so the data
          stays yours.
        </p>
      </div>

      <RelatedLinks links={[
        { label: 'SPF record syntax', href: '/guides/spf-record-syntax/', note: 'Every mechanism and qualifier, with examples.' },
        { label: 'SPF, DKIM & DMARC together', href: '/guides/spf-dkim-dmarc/', note: 'What each one actually does.' },
        { label: 'Why mail fails DMARC', href: '/guides/fix-dmarc-failure/', note: 'Diagnosing the failures reports show you.' },
        { label: 'DMARC record checker', href: '/tools/dmarc-checker/', note: 'The other half of the setup.' },
      ]} />

      <Cta />
    </section>
</BaseLayout>

<script>
  import { errorText, lookupTxt, LOOKS_LIKE_DOMAIN, normalizeDomain } from '../../lib/doh';
  import { revealResults } from '../../lib/motion';

  type Finding = {
    level: 'good' | 'warn' | 'bad';
    title: string;
    detail: string;
    link?: { href: string; label: string };
  };

  type Kind =
    | 'all' | 'include' | 'a' | 'mx' | 'ptr' | 'ip4' | 'ip6' | 'exists'
    | 'redirect' | 'exp' | 'modifier' | 'unknown';

  type Term = {
    raw: string;
    kind: Kind;
    qualifier: string;
    value: string;
    /** Whether this term counts against the limit of 10. */
    costs: boolean;
    /** 1-based position in the running lookup count, once counted. */
    at?: number;
    /** Not followed, and why. */
    skipped?: 'macro' | 'repeat' | 'depth' | 'budget';
  };

  type Node = {
    domain: string;
    record: string | null;
    problem?: string;
    /** Set only when the domain publishes more than one SPF record. */
    duplicates?: string[];
    terms: Term[];
    children: Node[];
    depth: number;
  };

  type State = {
    lookups: number;
    queries: number;
    visited: Set<string>;
    /** Domains whose include target has no usable SPF record. */
    dead: { domain: string; problem: string }[];
  };

  // The RFC limit. Named because it appears in the verdict, the findings and the
  // copy, and they must agree.
  const LOOKUP_LIMIT = 10;
  // Recursion and request ceilings. The lookup limit bounds a *conforming*
  // record; these bound a pathological one so the page cannot hammer a resolver.
  const MAX_DEPTH = 10;
  const MAX_QUERIES = 40;

  const LOOKUP_TERMS: Kind[] = ['include', 'a', 'mx', 'ptr', 'exists', 'redirect'];
  const MECHANISMS = ['all', 'include', 'a', 'mx', 'ptr', 'ip4', 'ip6', 'exists'];

  // Every id below is a static element in this page's own markup, so a null
  // would be a template bug rather than a runtime condition.
  const $ = <T extends HTMLElement = HTMLElement>(id: string) =>
    document.getElementById(id) as T;

  const domainInput = $<HTMLInputElement>('domainInput');
  const checkBtn = $<HTMLButtonElement>('checkBtn');
  const errorMsg = $('errorMsg');
  const results = $('results');

  const showError = (msg: string) => {
    errorMsg.textContent = msg;
    errorMsg.style.display = 'block';
    results.style.display = 'none';
  };
  const clearError = () => { errorMsg.style.display = 'none'; };

  const isSpf = (r: string) => /^v=spf1(\s|$)/i.test(r.trim());

  // ------------------------------------------------------------- parsing

  /**
   * One term of an SPF record.
   *
   * Modifiers are `name=value` and are checked first, because a mechanism never
   * contains `=`. A trailing dual-CIDR (`/24`, `//64`, `/24//64`) is stripped
   * before splitting on `:`, so `a/24` and `mx:example.com/24` both parse.
   */
  function parseTerm(raw: string): Term {
    const modifier = /^([a-z][a-z0-9_.-]*)=(.*)$/i.exec(raw);
    if (modifier) {
      const name = modifier[1].toLowerCase();
      const kind: Kind = name === 'redirect' ? 'redirect' : name === 'exp' ? 'exp' : 'modifier';
      return {
        raw,
        kind,
        qualifier: '',
        value: modifier[2].trim().replace(/\.$/, ''),
        costs: kind === 'redirect',
      };
    }

    const qualifier = /^[+\-~?]/.test(raw) ? raw[0] : '';
    const afterQualifier = qualifier ? raw.slice(1) : raw;

    const cidr = /(?:\/\d{1,3})?(?:\/\/\d{1,3})?$/.exec(afterQualifier);
    const body = cidr && cidr[0] ? afterQualifier.slice(0, -cidr[0].length) : afterQualifier;

    const colon = body.indexOf(':');
    const name = (colon === -1 ? body : body.slice(0, colon)).toLowerCase();
    const value = colon === -1 ? '' : body.slice(colon + 1).trim().replace(/\.$/, '');

    const kind: Kind = MECHANISMS.includes(name) ? (name as Kind) : 'unknown';
    return { raw, kind, qualifier, value, costs: LOOKUP_TERMS.includes(kind) };
  }

  function parseTerms(record: string): Term[] {
    return record
      .trim()
      .split(/\s+/)
      .slice(1) // drop v=spf1
      .filter(Boolean)
      .map(parseTerm);
  }

  // ------------------------------------------------------------ expansion

  /**
   * Resolve `domain`'s SPF record and recurse through its includes and redirect,
   * accumulating the lookup count in `state`.
   *
   * The count increments *before* the decision to recurse, so a term that is
   * skipped (a macro, a repeat, the depth cap) still costs what it costs at a
   * real receiver.
   */
  async function expand(domain: string, state: State, depth: number): Promise<Node> {
    const node: Node = { domain, record: null, terms: [], children: [], depth };

    if (state.queries >= MAX_QUERIES) {
      node.problem = 'not resolved — this page stopped after ' + MAX_QUERIES + ' DNS queries';
      return node;
    }
    state.queries++;

    let records: string[];
    try {
      records = (await lookupTxt(domain)).filter(isSpf);
    } catch (e) {
      node.problem = errorText(e, 'the lookup failed');
      return node;
    }

    if (records.length === 0) {
      node.problem = 'no SPF record';
      if (depth > 0) state.dead.push({ domain, problem: 'has no SPF record' });
      return node;
    }
    if (records.length > 1) {
      node.problem = `${records.length} SPF records — receivers treat this as permerror`;
      node.duplicates = records;
      if (depth > 0) state.dead.push({ domain, problem: `publishes ${records.length} SPF records` });
      return node;
    }

    node.record = records[0];
    node.terms = parseTerms(records[0]);

    for (const term of node.terms) {
      if (term.costs) {
        state.lookups += 1;
        term.at = state.lookups;
      }
      if (term.kind !== 'include' && term.kind !== 'redirect') continue;
      if (!term.value) continue;

      if (term.value.includes('%')) { term.skipped = 'macro'; continue; }

      const target = term.value.toLowerCase();
      if (state.visited.has(target)) { term.skipped = 'repeat'; continue; }
      if (depth + 1 > MAX_DEPTH) { term.skipped = 'depth'; continue; }
      if (state.queries >= MAX_QUERIES) { term.skipped = 'budget'; continue; }

      state.visited.add(target);
      node.children.push(await expand(target, state, depth + 1));
    }

    return node;
  }

  /** Every term in the tree, in evaluation order. */
  function allTerms(node: Node): Term[] {
    return [node.terms, ...node.children.map(allTerms)].flat();
  }

  // -------------------------------------------------------------- checks

  function check(root: Node, state: State): Finding[] {
    const out: Finding[] = [];
    const terms = root.terms;
    const total = state.lookups;

    // The headline. Over the limit is not "untidy", it is broken.
    if (total > LOOKUP_LIMIT) {
      out.push({
        level: 'bad',
        title: `${total} DNS lookups — over the limit of ${LOOKUP_LIMIT}`,
        detail: 'Receivers stop evaluating and return permerror, which counts as "SPF did not pass". Mail that authenticated yesterday can start failing, and nothing bounces to tell you.',
        link: { href: '/guides/spf-record-syntax/', label: 'How to get back under' },
      });
    } else if (total >= LOOKUP_LIMIT - 1) {
      out.push({
        level: 'warn',
        title: `${total} DNS lookups — at the edge of the limit of ${LOOKUP_LIMIT}`,
        detail: 'One more sender, or one more include added inside a vendor’s own record, breaks SPF. Worth reducing now rather than during an incident.',
      });
    } else {
      out.push({
        level: 'good',
        title: `${total} DNS lookup${total === 1 ? '' : 's'} of the ${LOOKUP_LIMIT} allowed`,
        detail: 'Comfortably inside the limit. Re-check after adding any sender — an include can bring several lookups with it.',
      });
    }

    // What happens to everything not explicitly authorised.
    const all = terms.find((t) => t.kind === 'all');
    const redirect = terms.filter((t) => t.kind === 'redirect');
    if (all) {
      const q = all.qualifier || '+';
      if (q === '+') {
        out.push({
          level: 'bad',
          title: '+all authorises the entire internet to send as you',
          detail: 'Every SPF check passes, from any server anywhere. This is worse than having no SPF record at all, because it looks like protection. Almost always a typo for -all or ~all.',
        });
      } else if (q === '?') {
        out.push({
          level: 'warn',
          title: '?all is neutral — the same as no opinion',
          detail: 'Unauthorised senders get an explicit "no comment", which does not pass SPF and does not fail it either. Use ~all while testing, then -all.',
        });
      } else if (q === '~') {
        out.push({
          level: 'good',
          title: '~all — softfail',
          detail: 'Unauthorised mail is marked suspicious rather than rejected. A sound place to sit while you confirm every legitimate sender is listed; -all is the end state.',
        });
      } else {
        out.push({
          level: 'good',
          title: '-all — fail',
          detail: 'Anything not authorised above fails SPF outright. The correct end state, once you are certain every legitimate sender is covered.',
        });
      }
    } else if (redirect.length === 0) {
      out.push({
        level: 'warn',
        title: 'No all mechanism',
        detail: 'Without a closing all, the result for unauthorised senders defaults to neutral — which does not pass SPF. Add ~all or -all.',
      });
    }

    // Terms after `all` are unreachable, which usually means an edit went wrong.
    if (all) {
      const index = terms.indexOf(all);
      const after = terms.slice(index + 1).filter((t) => t.kind !== 'exp' && t.kind !== 'modifier');
      if (after.length) {
        out.push({
          level: 'warn',
          title: `${after.length} term${after.length === 1 ? '' : 's'} after all will never be evaluated`,
          detail: `Evaluation stops at all, so these do nothing: ${after.map((t) => t.raw).join(' ')}. They still make the record longer and can still be miscounted by tools.`,
        });
      }
      if (redirect.length) {
        out.push({
          level: 'warn',
          title: 'redirect is ignored because all is present',
          detail: 'When a record has an all mechanism, redirect never applies (RFC 7208 §6.1). One of the two is not doing what you intended — and the redirect still costs a lookup.',
        });
      }
    }

    if (redirect.length > 1) {
      out.push({
        level: 'bad',
        title: `${redirect.length} redirect modifiers`,
        detail: 'A record may have at most one redirect. More than one is a permerror.',
      });
    }

    // Unknown terms are a permerror, not something receivers skip past.
    const unknown = terms.filter((t) => t.kind === 'unknown');
    if (unknown.length) {
      out.push({
        level: 'bad',
        title: `Unrecognised mechanism: ${unknown.map((t) => t.raw).join(', ')}`,
        detail: 'An unknown mechanism is a permerror for the whole record — receivers do not skip it. Check for a typo, and note that a bare hostname is not valid: it needs a: or include: in front of it.',
      });
    }

    // ptr is specified but the RFC tells you not to use it.
    const ptr = allTerms(root).filter((t) => t.kind === 'ptr');
    if (ptr.length) {
      out.push({
        level: 'warn',
        title: `ptr is used ${ptr.length === 1 ? 'once' : `${ptr.length} times`} and should not be`,
        detail: 'RFC 7208 §5.5 advises against ptr: it is slow, it puts load on other people’s DNS, and some receivers skip it entirely. Replace it with a, mx or ip4 ranges.',
      });
    }

    // Includes that cannot match anything, but still cost their lookup.
    for (const dead of state.dead) {
      out.push({
        level: 'warn',
        title: `${dead.domain} ${dead.problem}`,
        detail: 'That include can never authorise anything, but it still costs one of your 10 lookups. Either the sender has changed their record or the name is wrong.',
      });
    }

    // Terms that could not be followed here, so the count is a floor.
    const macros = allTerms(root).filter((t) => t.skipped === 'macro');
    if (macros.length) {
      out.push({
        level: 'warn',
        title: macros.length === 1
          ? 'One term uses a macro and was not expanded'
          : `${macros.length} terms use macros and were not expanded`,
        detail: `Macros such as %{i} resolve differently per message, so they cannot be followed without a specific sending IP: ${macros.map((t) => t.raw).join(' ')}. Each is counted as one lookup, but anything inside it is not — so the real total may be higher than shown.`,
      });
    }

    if (allTerms(root).some((t) => t.skipped === 'depth' || t.skipped === 'budget')) {
      out.push({
        level: 'warn',
        title: 'The record was too deep to expand fully',
        detail: `This page stops at ${MAX_DEPTH} levels and ${MAX_QUERIES} queries. A record that deep is already well past the point of working, so treat the count as a floor.`,
      });
    }

    // A single TXT string cannot exceed 255 bytes.
    if (root.record) {
      const bytes = new TextEncoder().encode(root.record).length;
      if (bytes > 255) {
        out.push({
          level: 'warn',
          title: `The record is ${bytes} bytes`,
          detail: 'A single TXT string tops out at 255 bytes, so this has to be published as multiple chunks. That is legal and receivers join them, but it is a sign the record is doing too much — and RFC 7208 §3.4 asks that the whole answer fit in 512 bytes.',
        });
      }
    }

    return out;
  }

  // ----------------------------------------------------------- rendering

  const PALETTE = {
    good: { bg: 'var(--teal-100)', fg: 'var(--brand-hover)', mark: '✓' },
    warn: { bg: '#fef3c7', fg: '#92400e', mark: '!' },
    bad: { bg: 'var(--status-danger-bg)', fg: 'var(--status-danger-fg)', mark: '×' },
  };

  function badge(level: Finding['level'], size = 22) {
    const el = document.createElement('span');
    el.textContent = PALETTE[level].mark;
    el.setAttribute('aria-hidden', 'true');
    el.style.cssText = `flex:0 0 auto; width:${size}px; height:${size}px; margin-top:1px; border-radius:var(--radius-pill); display:inline-flex; align-items:center; justify-content:center; font-size:${size > 20 ? 13 : 11}px; font-weight:700; background:${PALETTE[level].bg}; color:${PALETTE[level].fg};`;
    return el;
  }

  function findingRow(f: Finding) {
    const row = document.createElement('li');
    row.style.cssText = 'display:flex; gap:12px; padding:14px 16px; border-top:1px solid var(--surface-sunken);';

    const body = document.createElement('div');
    body.style.cssText = 'min-width:0;';

    const heading = document.createElement('div');
    heading.textContent = f.title;
    heading.style.cssText = 'font-size:var(--text-base); font-weight:600; color:var(--text-body); overflow-wrap:anywhere;';

    const detail = document.createElement('div');
    detail.textContent = f.detail;
    detail.style.cssText = 'margin-top:3px; font-size:var(--text-sm); line-height:1.55; color:var(--gray-700); overflow-wrap:anywhere;';

    body.append(heading, detail);

    if (f.link) {
      const a = document.createElement('a');
      a.href = f.link.href;
      a.textContent = f.link.label + ' →';
      a.style.cssText = 'display:inline-block; margin-top:6px; font-size:var(--text-sm); font-weight:600;';
      body.appendChild(a);
    }

    row.append(badge(f.level), body);
    return row;
  }

  function heading(text: string, tag: 'h2' | 'h3' = 'h2') {
    const h = document.createElement(tag);
    h.textContent = text;
    h.style.cssText = `font-family:'Space Grotesk',sans-serif; font-size:${tag === 'h2' ? 'var(--text-lg)' : 'var(--text-md)'}; font-weight:600; letter-spacing:-0.01em; margin:0 0 12px;`;
    return h;
  }

  function recordBlock(record: string) {
    const pre = document.createElement('pre');
    pre.textContent = record;
    pre.style.cssText = "margin:0 0 20px; padding:14px 16px; border:1px solid var(--border-strong); border-radius:var(--radius-lg); background:var(--surface-page); font-family:'JetBrains Mono',monospace; font-size:13px; line-height:1.6; color:var(--gray-800); white-space:pre-wrap; overflow-wrap:anywhere;";
    return pre;
  }

  /** The lookup budget as a bar, because a count out of 10 is a budget. */
  function meter(total: number) {
    const level: Finding['level'] = total > LOOKUP_LIMIT ? 'bad' : total >= LOOKUP_LIMIT - 1 ? 'warn' : 'good';
    const wrap = document.createElement('div');
    wrap.style.cssText = `padding:14px 16px; margin-bottom:16px; border-radius:var(--radius-lg); background:${PALETTE[level].bg};`;

    const row = document.createElement('div');
    row.style.cssText = `display:flex; align-items:baseline; justify-content:space-between; gap:12px; font-weight:600; color:${PALETTE[level].fg};`;
    const left = document.createElement('span');
    left.textContent = `${total} of ${LOOKUP_LIMIT} DNS lookups used`;
    left.style.cssText = 'font-size:var(--text-md);';
    const right = document.createElement('span');
    right.textContent = total > LOOKUP_LIMIT ? 'permerror' : total >= LOOKUP_LIMIT - 1 ? 'at the edge' : 'within the limit';
    right.style.cssText = 'font-size:var(--text-sm);';
    row.append(left, right);

    const track = document.createElement('div');
    track.style.cssText = 'margin-top:10px; height:8px; border-radius:var(--radius-pill); background:rgba(0,0,0,0.09); overflow:hidden;';
    const fill = document.createElement('div');
    fill.style.cssText = `height:100%; width:${Math.min(100, (total / LOOKUP_LIMIT) * 100)}%; background:${PALETTE[level].fg}; border-radius:var(--radius-pill);`;
    track.appendChild(fill);

    wrap.append(row, track);
    return wrap;
  }

  const SKIPPED_LABEL: Record<string, string> = {
    macro: 'contains a macro — not expanded',
    repeat: 'already expanded above',
    depth: 'too deep to expand',
    budget: 'query budget reached',
  };

  /** The expansion, flattened to indented rows so it stays readable at 390px. */
  function tree(node: Node, into: HTMLElement) {
    const indent = node.depth * 16;

    const header = document.createElement('li');
    header.style.cssText = `padding:10px 16px 10px ${16 + indent}px; border-top:1px solid var(--surface-sunken); background:${node.depth === 0 ? 'var(--surface-page)' : 'transparent'};`;

    const name = document.createElement('div');
    name.className = 'mono';
    name.textContent = node.domain;
    name.style.cssText = 'font-size:13px; font-weight:600; color:var(--text-body); overflow-wrap:anywhere;';
    header.appendChild(name);

    if (node.problem) {
      const problem = document.createElement('div');
      problem.textContent = node.problem;
      problem.style.cssText = 'margin-top:2px; font-size:var(--text-sm); color:var(--status-danger-fg);';
      header.appendChild(problem);
    }
    into.appendChild(header);

    for (const term of node.terms) {
      if (term.kind === 'exp' || term.kind === 'modifier') continue;

      const row = document.createElement('li');
      row.style.cssText = `display:flex; align-items:baseline; gap:10px; padding:5px 16px 5px ${32 + indent}px; font-size:12.5px;`;

      const cost = document.createElement('span');
      cost.className = 'mono';
      cost.textContent = term.at ? `#${term.at}` : '—';
      cost.style.cssText = `flex:0 0 auto; min-width:26px; text-align:right; color:${term.at ? (term.at > LOOKUP_LIMIT ? 'var(--status-danger-fg)' : 'var(--brand)') : 'var(--text-faint)'}; font-weight:${term.at ? 600 : 400};`;

      const raw = document.createElement('span');
      raw.className = 'mono';
      raw.textContent = term.raw;
      raw.style.cssText = 'color:var(--gray-800); overflow-wrap:anywhere;';

      row.append(cost, raw);

      if (term.skipped) {
        const note = document.createElement('span');
        note.textContent = SKIPPED_LABEL[term.skipped];
        note.style.cssText = 'color:var(--text-faint);';
        row.appendChild(note);
      }

      into.appendChild(row);

      // Nest this include's own record directly beneath the term that pulled it
      // in, which is the only ordering that makes the count readable.
      if (term.kind === 'include' || term.kind === 'redirect') {
        const child = node.children.find((c) => c.domain === term.value.toLowerCase());
        if (child) tree(child, into);
      }
    }
  }

  function render(root: Node, state: State, findings: Finding[]) {
    results.textContent = '';
    results.appendChild(heading(`SPF record for ${root.domain}`));
    if (root.record) results.appendChild(recordBlock(root.record));
    results.appendChild(meter(state.lookups));

    const order = { bad: 0, warn: 1, good: 2 };
    const list = document.createElement('ul');
    list.style.cssText = 'list-style:none; margin:0; padding:0; border:1px solid var(--border-default); border-radius:var(--radius-lg); overflow:hidden; background:var(--surface-card);';
    [...findings].sort((a, b) => order[a.level] - order[b.level]).forEach((f) => list.appendChild(findingRow(f)));
    results.appendChild(list);

    const treeHeading = heading('How the lookups add up', 'h3');
    treeHeading.style.marginTop = '28px';
    results.appendChild(treeHeading);

    const legend = document.createElement('p');
    legend.textContent = `Numbered terms cost a DNS lookup; dashes are free. Includes are expanded beneath the term that pulled them in. ${state.queries} DNS quer${state.queries === 1 ? 'y' : 'ies'} were made.`;
    legend.style.cssText = 'margin:0 0 12px; font-size:var(--text-sm); color:var(--text-faint);';
    results.appendChild(legend);

    const treeList = document.createElement('ul');
    treeList.style.cssText = 'list-style:none; margin:0; padding:0 0 8px; border:1px solid var(--border-default); border-radius:var(--radius-lg); overflow:hidden; background:var(--surface-card);';
    tree(root, treeList);
    results.appendChild(treeList);

    results.style.display = 'block';
  }

  // ------------------------------------------------------------ the check

  async function run(raw: string) {
    const domain = normalizeDomain(raw);
    clearError();

    if (!domain) { showError('Enter a domain to check.'); return; }
    if (!LOOKS_LIKE_DOMAIN.test(domain)) {
      showError(`"${domain}" does not look like a domain name. Enter something like yourdomain.com.`);
      return;
    }

    domainInput.value = domain;
    checkBtn.disabled = true;
    checkBtn.textContent = 'Checking…';

    try {
      const state: State = { lookups: 0, queries: 0, visited: new Set([domain]), dead: [] };
      const root = await expand(domain, state, 0);

      if (!root.record) {
        // Three distinct outcomes, and collapsing them into one message would
        // hide the most fixable of them: two records is a specific, common
        // mistake with a specific fix, not a failure to read anything.
        const duplicates = root.duplicates;
        const finding: Finding = duplicates
          ? {
              level: 'bad',
              title: `${duplicates.length} SPF records for ${domain}`,
              detail: `A domain may publish exactly one. Receivers that find several return permerror, which counts as "SPF did not pass" — so two records is worse than either one alone. This is what happens when a long record is "split in half" to get under the lookup limit. Merge them into one: ${duplicates.join('  |  ')}`,
              link: { href: '/guides/spf-record-syntax/', label: 'Merging them safely' },
            }
          : root.problem === 'no SPF record'
            ? {
                level: 'bad',
                title: `No SPF record at ${domain}`,
                detail: 'Nothing in this domain’s TXT records starts with v=spf1, so no server is authorised to send on its behalf and SPF cannot pass.',
                link: { href: '/guides/spf-record-syntax/', label: 'How to publish one' },
              }
            : {
                level: 'bad',
                title: `Could not read an SPF record for ${domain}`,
                detail: `${root.problem}.`,
              };

        results.textContent = '';
        results.appendChild(heading(finding.title));
        const list = document.createElement('ul');
        list.style.cssText = 'list-style:none; margin:0; padding:0; border:1px solid var(--border-default); border-radius:var(--radius-lg); overflow:hidden; background:var(--surface-card);';
        list.appendChild(findingRow(finding));
        results.appendChild(list);
        results.style.display = 'block';
      } else {
        render(root, state, check(root, state));
      }

      const url = new URL(window.location.href);
      url.searchParams.set('domain', domain);
      window.history.replaceState(null, '', url);
      revealResults(results);
    } catch (e) {
      showError(errorText(e, 'Something went wrong looking that up.'));
    } finally {
      checkBtn.disabled = false;
      checkBtn.textContent = 'Check';
    }
  }

  checkBtn.addEventListener('click', () => run(domainInput.value));
  domainInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') run(domainInput.value);
  });
  // Eight includes, sitting at exactly 10 lookups — the interesting case, and a
  // real one. Its record is also chunked mid-address, which is a live test of
  // the concatenation rule in lib/doh.
  $('sampleBtn').addEventListener('click', () => {
    domainInput.value = 'github.com';
    run('github.com');
  });

  const initial = new URLSearchParams(window.location.search).get('domain');
  if (initial) { domainInput.value = initial; run(initial); }
</script>
